rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function manager() {
      return request.auth != null && (request.auth.token.email == 'egor.novoselisev@gmail.com'
        || (get(/databases/$(database)/documents/users/$(request.auth.token.email.split('@')[0])).data.active == true
          && get(/databases/$(database)/documents/users/$(request.auth.token.email.split('@')[0])).data.role in ['setter', 'foreman']));
    }
    function setter() {
      return request.auth != null && (request.auth.token.email == 'egor.novoselisev@gmail.com'
        || (get(/databases/$(database)/documents/users/$(request.auth.token.email.split('@')[0])).data.active == true
          && get(/databases/$(database)/documents/users/$(request.auth.token.email.split('@')[0])).data.role == 'setter'));
    }
    match /appData/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && document == 'production';
      allow write: if document == 'assignments' && manager();
      allow create, update: if document.matches('photo-.*') && setter()
        && request.resource.data.image is string && request.resource.data.image.size() < 240000;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == 'egor.novoselisev@gmail.com';
    }
  }
}
